#!/bin/sh
# Refuses commits that add secrets (docs/PLAN.md section 9).
# Enabled per clone with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit blocked." >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
